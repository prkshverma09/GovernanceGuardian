# Elastic Cloud Project Credentials
# Copy this to .env and fill in the values

ELASTIC_CLOUD_ID=your_cloud_id_here
ELASTIC_API_KEY=your_api_key_here
ELASTICSEARCH_URL=https://your_endpoint_here:443

# Agent Builder (for Streamlit chat)
ELASTIC_AGENT_ID=your_agent_id_here

# Remediation demo: public URL so Elastic Cloud can call your local API (e.g. from ngrok)
# REMEDIATION_WEBHOOK_URL=https://your-ngrok-host.ngrok-free.app
